#!/bin/bash
#

#SBATCH --job-name=ej2
#SBATCH --output=out.txt
#SBATCH --error=out.txt

## For partition: either prod10, prod 20, prod 40 or prod80
## For gres: either 1g.10gb:[1:10] for prod10, 2g.20gb:[1:4] for prod20, 3g.40gb:1 for prod40 or A100.80gb for prod80.

##SBATCH --partition=prod10
##SBATCH --gres=gpu:1g.10gb:1
##SBATCH --cpus-per-task=4

##SBATCH --partition=prod10
##SBATCH --gres=gpu:1g.10gb:1
##SBATCH --cpus-per-task=4

#SBATCH --partition=prod20
#SBATCH --gres=gpu:2g.20gb:1
#SBATCH --cpus-per-task=4

##SBATCH --partition=prod80
##SBATCH --gres=gpu:A100.80gb:1
##SBATCH --ntasks-per-node=1
##SBATCH --cpus-per-task=8
##SBATCH --mem-per-cpu=10G
##SBATCH --nodes=1

## For ntasks and cpus: total requested cpus (ntasks * cpus-per-task) must be in [1: 4 * nMIG] with nMIG = nb_1g.10gb | 2 * nb_2g.20gb | 4 * nb_3g.40gb | 8 * nb_A100.80gb


## N tasks
#SBATCH --ntasks=1

## Walltime limit
#SBATCH --time=24:00:00

## Setup
source ~/projects/EcoJAX/venv_linux/bin/activate
cd ~/projects/EcoJAX

## Create a directory to store the logs
initial_date=$(date +"%Y%m%d_%H%M%S")

## Iterate over the seeds
seed_max=10
benchmark_name='bench53'
model='region'
for k in $(seq 1 $seed_max); do
    seed=$RANDOM 
    list_omega=(1 0.7)
    for i in $(seq 0 $((${#list_omega[@]} - 1))); do
        omega=${list_omega[$i]}
        run_name="run_$initial_date-$benchmark_name-$model/omega_$omega/seed_$seed"
        log_dir="logs/$run_name"
        echo "Running $log_dir"
        mkdir -p "$log_dir"
        python run.py --config-name dgx do_wandb=True env/metrics=metrics_dgx +benchmark_name=$benchmark_name seed=$seed +run_name=\'$run_name\' \
            env.sum_energy_map_ref=275 \
            agents=ada_r_hc \
            agents.hp_initial.strength_mutation=0.05 \
            env=fruits_plants \
            env.mode_variability_fruits=space_diffusion \
            env.omega=$omega \
            model=$model \
            env.prop_empty_clusters=0.15 \
            agents.mode_weights_transmission=final \
            agents.do_include_value_fruit=True \
            agents.do_include_values_other_fruits=False \
            agents.do_include_id_fruit=True \
            > "$log_dir"/log.txt 2>&1
    done
done